# ---- Required when js/config.js has backend: 'api' ----
# Postgres connection string (Supabase → Project Settings → Database → "Connection string", use the pooler URI for Vercel).
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 32 random bytes, base64. Encrypts site credentials at rest. Generate:  openssl rand -base64 32
# Losing this key means every stored site connection has to be re-entered.
ENCRYPTION_KEY=

# Protects /api/cron/scan. Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>" on cron hits.
CRON_SECRET=

# ---- Auth: pick ONE ----
# (a) Supabase Auth — real user accounts, agencies, roles. Set js/config.js supabase: { url, anonKey } so the
#     console shows a sign-in screen. Sign-in tokens are verified in one of two ways, depending on the project:
#       - Projects on "JWT Signing Keys" (the default for new projects) sign tokens with ES256. The API verifies
#         them against the project's public keys — nothing secret to copy. SUPABASE_URL is optional: it defaults
#         to the url in js/config.js. Set it only if the API should trust a different project.
#       - Older projects on the legacy "JWT secret" sign tokens with HS256. Copy the secret from
#         Supabase → Project Settings → JWT Keys → Legacy JWT Secret.
# SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_JWT_SECRET=
# (b) Single-agency mode — one shared bearer token (also put it in js/config.js apiToken). No user accounts.
# RANKOPS_API_TOKEN=change-me-to-a-long-random-string
# RANKOPS_AGENCY_ID=default
# RANKOPS_AGENCY_NAME=Web Solution Zone

# ---- AI review (optional; can also be set per agency in the console under AI Settings, encrypted) ----
# AI_PROVIDER=anthropic          # anthropic | openai
# ANTHROPIC_API_KEY=sk-ant-...    # used when the agency has no stored key
# OPENAI_API_KEY=sk-...
# AI_MODEL=claude-opus-5          # default per provider: claude-opus-5 / gpt-5
# AI_REVIEW_BUDGET_MS=45000       # wall-clock budget for ONE request of a review (auth, DB reads, model
                                 # turns, writes). A review needing more is paused and continued in the
                                 # next request automatically, so this only has to stay under Vercel's
                                 # function limit (60 s on Hobby). Raise it only with functions.maxDuration.
# AI_EFFORT=medium                # low | medium | high | xhigh | max — Claude's reasoning effort per turn.
                                 # Lower is faster and cheaper; medium keeps a review to ~30 s–2 min.

# ---- Optional ----
# Google PageSpeed Insights API key; without it the Core Web Vitals check reports "unknown".
# PSI_API_KEY=
# How long a scan may run inside the request that started it (ms). The Cron continues anything left.
# INLINE_SCAN_BUDGET_MS=20000
# PGSSL=disable   # only for a local Postgres without TLS

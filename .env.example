# ---- Required when js/config.js has backend: 'api' ----
# Postgres connection string (Supabase → Project Settings → Database → "Connection string", use the pooler URI for Vercel).
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 32 random bytes, base64. Encrypts site credentials at rest. Generate:  openssl rand -base64 32
# Losing this key means every stored site connection has to be re-entered.
ENCRYPTION_KEY=

# Protects /api/cron/scan. Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>" on cron hits.
CRON_SECRET=

# ---- Auth: pick ONE ----
# (a) Supabase Auth — real user accounts, agencies, roles. Supabase → Project Settings → API → "JWT Secret".
#     Also set js/config.js supabase: { url, anonKey } so the console shows a sign-in screen.
SUPABASE_JWT_SECRET=
# (b) Single-agency mode — one shared bearer token (also put it in js/config.js apiToken). No user accounts.
# RANKOPS_API_TOKEN=change-me-to-a-long-random-string
# RANKOPS_AGENCY_ID=default
# RANKOPS_AGENCY_NAME=Web Solution Zone

# ---- Optional ----
# Google PageSpeed Insights API key; without it the Core Web Vitals check reports "unknown".
# PSI_API_KEY=
# How long a scan may run inside the request that started it (ms). The Cron continues anything left.
# INLINE_SCAN_BUDGET_MS=20000
# PGSSL=disable   # only for a local Postgres without TLS

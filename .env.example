# Only needed when js/config.js has backend: 'api'. Set these on the Vercel project (Settings → Environment Variables).
DATABASE_URL=postgres://user:password@host:5432/rankops
RANKOPS_API_TOKEN=change-me-to-a-long-random-string
# Optional: which agency row the API serves (see db/schema.sql). Defaults to "default".
# RANKOPS_AGENCY_ID=default
